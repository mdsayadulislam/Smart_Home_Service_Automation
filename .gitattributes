# Auto-detect text files and normalize line endings
* text=auto

# Explicitly declare web file types
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Binary files — no line-ending conversion
*.png   binary
*.jpg   binary
*.ico   binary
*.svg   binary
